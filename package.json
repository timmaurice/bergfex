{
  "name": "bergfex-card",
  "version": "3.0.0",
  "description": "A Lovelace card to display ski resort conditions from Bergfex.",
  "homepage": "https://github.com/timmaurice/bergfex#readme",
  "bugs": {
    "url": "https://github.com/timmaurice/bergfex/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/timmaurice/bergfex.git"
  },
  "license": "MIT",
  "author": "Tim Maurice Bayer",
  "type": "module",
  "main": "custom_components/bergfex/bergfex-card.js",
  "scripts": {
    "build": "rollup -c",
    "check-format": "prettier --check .",
    "format": "prettier . --write",
    "lint": "eslint frontend/",
    "test": "NODE_ENV=production vitest run",
    "watch": "rollup -c -w"
  },
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "jsdom": "^29.1.1",
    "lit": "^3.3.3",
    "prettier": "~3.8.5",
    "rollup": "^4.62.2",
    "rollup-plugin-lit-css": "^6.0.1",
    "rollup-plugin-string": "^3.0.0",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "vanilla-colorful": "^0.7.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true
  }
}
