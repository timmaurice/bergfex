{
  "name": "bergfex-card",
  "version": "3.0.0",
  "description": "A Lovelace card to display ski resort conditions from Bergfex.",
  "homepage": "https://github.com/timmaurice/bergfex#readme",
  "bugs": {
    "url": "https://github.com/timmaurice/bergfex/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/timmaurice/bergfex.git"
  },
  "license": "MIT",
  "author": "Tim Maurice Bayer",
  "type": "module",
  "main": "custom_components/bergfex/bergfex-card.js",
  "scripts": {
    "build": "rollup -c",
    "build:release": "node scripts/build-release-zip.mjs",
    "check-format": "prettier --check .",
    "format": "prettier . --write",
    "lint": "eslint frontend/ scripts/ *.config.mjs rollup.config.js",
    "test": "NODE_ENV=production vitest run",
    "watch": "rollup -c -w",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "jsdom": "30.0.1",
    "lit": "^3.3.3",
    "prettier": "^3.9.8",
    "rollup": "^4.63.4",
    "rollup-plugin-lit-css": "^6.0.1",
    "rollup-plugin-string": "^3.0.0",
    "sass": "^1.104.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "globals": "^17.12.0",
    "tslib": "^2.8.1",
    "vanilla-colorful": "^0.7.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true
  }
}
